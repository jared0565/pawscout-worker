{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillOverrides": {
    "graphify": "off"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -m graphite build F:/Projects/Shopify/demo-store2/pawscout-worker",
            "timeout": 120,
            "statusMessage": "Rebuilding Graphite code graph (0 tokens)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m graphite agent-hook stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python F:/Projects/Shopify/demo-store2/pawscout-worker/.claude/graph-reminder.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python -m graphite agent-hook pre-tool-use --mode remind"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m graphite agent-hook session-start"
          }
        ]
      }
    ]
  }
}
