{
  "name": "pawscout-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:raw": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "migrate:rehearse": "node scripts/rehearse-migrations.mjs",
    "test": "vitest run",
    "test:ci": "node scripts/test-ci.mjs",
    "test:scripts": "node --test \"scripts/lib/*.nodetest.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate:local": "wrangler d1 migrations apply pawscout --local",
    "migrate:remote:raw": "wrangler d1 migrations apply pawscout --remote"
  },
  "dependencies": {
    "@shopify/shopify-api": "^11.6.0",
    "hono": "^4.6.0",
    "postal-mime": "^2.7.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jose": "^5.10.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5"
  }
}
